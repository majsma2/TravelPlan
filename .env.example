# ====== 高德地图 API（用户自行填写）======
# Web 服务 Key（后端调驾车 v5 API）
AMAP_WEB_KEY=bf7da06d5a1fd79bd7bc10f96a7a5f55
# Web 服务数字签名私钥（控制台-我的应用-设置-数字签名处查看）
# 若 Key 开启了数字签名验证（错误码 INVALID_USER_SIGNATURE / infocode=10007），必须填写
# 不开启则留空即可
AMAP_WEB_SIG_SECRET=
# JS API Key（前端渲染地图 + POI 搜索）
AMAP_JS_KEY=3b8079ae1a16ff9d5222e4d991ee7a33
# JS API 安全密钥（2021-12-02 后申请的 key 必须配）
AMAP_JS_SECURITY=4e81890fe622c171a8c59baa6d8a58ba

# ====== 后端配置 ======
PORT=8787
# 每日高德 API 调用配额上限
DAILY_QUOTA=2000
# 驾车缓存有效期（天）
DRIVING_TTL_DAYS=7
